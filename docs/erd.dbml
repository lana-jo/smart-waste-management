// ERD Smart Waste Management System - Phase 1 (PRD section 3.4)
// Dua tabel inti: users dan waste_reports (relasi 1:N).
// Skema sumber: docs/init_snapshot.sql. Render cara lain: dbdiagram.io.

Project smart_waste_management {
  database_type: 'PostgreSQL'
  Note: 'Phase 1: auth (JWT) + laporan sampah (AI classification, 3 kategori).'
}

Table users {
  id uuid [pk]
  name varchar(100) [not null]
  email varchar(100) [not null, unique]
  password_hash varchar(255) [not null]
  role varchar(20) [not null, default: 'user', note: 'admin | user']
  created_at timestamp [not null, default: `now()`]
}

Table waste_reports {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  image_url text [not null]
  category varchar(50) [not null, note: 'Organic Waste | Plastic Waste | Paper Waste']
  confidence float [not null, default: 0.0]
  description text
  latitude decimal(10,8)
  longitude decimal(11,8)
  status varchar(30) [not null, default: 'Pending', note: 'Pending | In Progress | Completed | Rejected']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}
