DATABASE_URL=postgresql+psycopg://postgres:password_rahasia_123@127.0.0.1:5432/smart_waste_db
# Wajib sama dengan POSTGRES_PASSWORD docker-compose (fail-closed).
POSTGRES_PASSWORD=password_rahasia_123
# Storage rate limiter lintas worker; kosong = memory per-proses.
# Contoh: redis://127.0.0.1:6379/0 (butuh paket limits[redis]).
REDIS_URL=
# Seed dev: isi manual saat menjalankan seed.sql via psql -v (lihat seed.sql).
JWT_SECRET=change-me-ganti-dengan-secret-acak-minimal-32-karakter
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45
UPLOAD_DIR=uploads
COOKIE_SECURE=true
CORS_ALLOW_ALL=false
CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS_CSV=
TRUSTED_PROXIES=127.0.0.1,::1
